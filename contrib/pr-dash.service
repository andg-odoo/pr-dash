[Unit]
Description=pr-dash unattended refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A refresh that has AI reviews to run takes minutes, well past the 90s default.
TimeoutStartSec=30min
# systemd user units get a bare PATH: gh lives in /usr/bin, claude in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/andg/.pyenv/versions/odoo/bin/pr-dash refresh --cron
