[Unit]
Description=Quarter-hourly pr-dash refresh

[Timer]
OnCalendar=*:0/15
# Run a tick missed while the laptop slept, once it wakes.
Persistent=true
# Spread the GitHub and AI calls over five minutes rather than on the quarter hour.
RandomizedDelaySec=300
# The same delay every tick keeps them 15 minutes apart, as mine_staleness_minutes expects.
FixedRandomDelay=true

[Install]
WantedBy=timers.target
