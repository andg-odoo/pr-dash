<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>pr-dash · {{ pr_count }} PRs</title>
<style>{{ diff2html_css|safe }}</style>
<style>{{ app_css|safe }}</style>
</head>
<body>
  {% set views = [
    {"key": "queue", "marks": [("h", "hide")],
     "groups": [("repo", "Repo"), ("bucket", "Bucket"), ("branch", "Branch"), ("state", "State")],
     "sorts": [("default", "default"), ("req_age_desc", "requested oldest"),
               ("req_age_asc", "requested newest"), ("bucket", "bucket size"), ("size", "size desc")]},
    {"key": "tracked", "marks": [("x", "dismiss")], "groups": [("tracked-state", "Show")],
     "sorts": [("active", "active first"), ("moved", "moved since last look"),
               ("resolved", "merged / closed first"), ("age", "oldest opened"),
               ("repo", "repo, then number")]},
    {"key": "mine", "marks": [("a", "acknowledge"), ("x", "dismiss")],
     "groups": [("mine-state", "Show")], "sorts": []},
  ] %}
  {% if offline %}
  <div class="banner">Offline mode{% if last_refresh %} - last refresh {{ last_refresh }}{% endif %}</div>
  {% endif %}

  <div class="layout">
    <aside class="left">
      <header class="left-header">
        <h1>pr-dash</h1>
        <nav class="tabs" id="tabs">
          {% for v in views %}
          <button type="button" class="tab{% if loop.first %} is-active{% endif %}" data-tab="{{ v.key }}">
            {{ v.key }}
            {% if v.key in counts %}<span class="tab-count" id="{{ v.key }}-tab-count">{{ counts[v.key] }}</span>{% endif %}
          </button>
          {% endfor %}
        </nav>
        <div class="meta">
          <span class="count-line">
            <span id="visible-count">{{ pr_count }} / {{ pr_count }}</span>
            <span id="total-count">active PRs</span>
            <span class="kpi" id="kpi"></span>
            <span class="look-count" id="look-count"></span>
          </span>
          <span class="last-refresh" id="last-refresh" data-at="{{ last_refresh }}"></span>
          <button id="reset-filters" type="button">reset</button>
        </div>
      </header>

      <div class="search-bar">
        <input id="search" type="search" autocomplete="off" spellcheck="false"
               placeholder="Search title, #, author, module…  ( / )">
      </div>

      {% for v in views %}
      <section class="filters" id="{{ v.key }}-filters"{% if not loop.first %} hidden{% endif %}>
        {% for group, label in v.groups %}
        <div class="filter-group" data-group="{{ group }}">
          <div class="filter-label">{{ label }}</div>
          <div class="chips"></div>
        </div>
        {% endfor %}
      </section>

      <div class="sort-bar" id="{{ v.key }}-sort-bar"{% if not loop.first %} hidden{% endif %}>
        {% if v.sorts %}
        <label>Sort:</label>
        <select id="{{ v.key }}-sort">
          {% for value, label in v.sorts %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
        </select>
        {% endif %}
        {% set marks = v.marks|map("join", " ")|join(" · ") %}
        <span class="kbd-hint" title="j/k move · o or enter open on GitHub · {{ marks }}{% if loop.first %} · / search{% endif %}">
          <kbd>j</kbd><kbd>k</kbd> move · <kbd>o</kbd> open
          {%- for k, label in v.marks %} · <kbd>{{ k }}</kbd> {{ label }}{% endfor %}
        </span>
      </div>

      <ol class="pr-list" id="{{ v.key }}-list"{% if not loop.first %} hidden{% endif %}></ol>
      {% endfor %}
    </aside>

    <main class="right" id="detail">
      <div class="empty">Select a PR on the left.</div>
    </main>
  </div>

  <script>
    window.TAB_DATA = {{ tab_data_json|safe }};
    window.HIDDEN_SERVER = {{ hidden_server_json|safe }};
    window.HIDDEN_SYNC_PORT = {{ hidden_sync_port }};
  </script>
  <script>{{ diff2html_js|safe }}</script>
  <script>{{ markdown_it_js|safe }}</script>
  <script>{{ app_js|safe }}</script>
</body>
</html>
